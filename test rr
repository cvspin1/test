<meta name="description" content="الخميرة البلدية المجففة من راحة بيو. خميرة طبيعية 100%، 100 غ. توصيل لباب الدار والدفع عند الاستلام.">
<meta property="og:title" content="راحة بيو | الخميرة البلدية المجففة">
<meta property="og:image" content="assets/product.jpg">
