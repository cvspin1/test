  جميع الحقوق محفوظة © 2026
</div></footer>

<div class="sticky"><a class="btn full" href="#order" style="padding:12px">اطلب الآن · 119 درهم</a></div>

<script>
(function(){
  // الصق هنا رابط Google Apps Script (ينتهي بـ /exec)
  var SHEET_URL = "https://script.google.com/macros/s/AKfycbzE9d8aIDdJx48rClyQpyc8z-meooKP5b1uUUMzqIDCGNIXNz3sHMNaTmGtpzXewbCawA/exec";
  var f = document.getElementById('f');
  var fe = document.getElementById('fe'), sb = document.getElementById('sb');
  function setErr(n,m){var e=f.querySelector('[data-for="'+n+'"]');if(e)e.textContent=m||''}
  f.addEventListener('submit',function(ev){
    ev.preventDefault();
    var d={name:f.name.value.trim(),phone:f.phone.value.replace(/[\s.-]/g,''),city:f.city.value.trim(),addr:f.addr.value.trim(),offer:f.offer.value};
    var bad=false;
    setErr('name');setErr('phone');setErr('city');fe.textContent='';
    if(d.name.length<3){setErr('name','دخل اسمك الكامل');bad=true}
    if(!/^(\+212|00212|0)[5-7]\d{8}$/.test(d.phone)){setErr('phone','دخل رقم هاتف مغربي صحيح');bad=true}
    if(d.city.length<2){setErr('city','دخل المدينة');bad=true}
    if(bad)return;
    if(SHEET_URL.indexOf('PASTE_')===0){fe.textContent='رابط Google Sheets ما تحطش بعد في الكود.';return}
    sb.disabled=true;sb.textContent='جاري الإرسال...';
    fetch(SHEET_URL,{method:'POST',mode:'no-cors',body:new URLSearchParams(d)})
      .then(function(){window.location.href='thank-you.html'})
      .catch(function(){sb.disabled=false;sb.textContent='تأكيد الطلب';fe.textContent='وقع مشكل، عاود حاول من فضلك.'});
  });
})();
</script>
</body>
</html>
